{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReceiptData",
  "type": "object",
  "required": ["merchant", "amount", "currency", "category", "items"],
  "properties": {
    "merchant": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "category": {
      "type": "string",
      "enum": ["groceries", "dining", "travel", "office_supplies", "utilities", "other"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
